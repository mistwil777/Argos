# ============================================
# CONFIGURATION ACADÉMIAOPS
# ============================================
# 
# Ce fichier contient toutes les variables d'environnement nécessaires.
# 
# INSTRUCTIONS :
# 1. Copier ce fichier : cp .env.example .env
# 2. Remplir toutes les valeurs entre < >
# 3. Ne JAMAIS commiter le fichier .env (il est dans .gitignore)
#
# ============================================

# ============================================
# POSTGRESQL (Base de données relationnelle)
# ============================================
POSTGRES_USER=academiaops
POSTGRES_PASSWORD=<générer_un_mot_de_passe_fort>  # Utiliser : pwgen 32 1
POSTGRES_DB=academiaops
POSTGRES_HOST=postgres  # Nom du service Docker
POSTGRES_PORT=5432

# URL de connexion complète (générée automatiquement si les variables ci-dessus sont remplies)
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# LANCEDB (Base de données vectorielle)
# ============================================
LANCEDB_PATH=/data/lancedb  # Chemin dans le container Docker

# ============================================
# n8n (Automatisation)
# ============================================
N8N_USER=admin
N8N_PASSWORD=<générer_un_mot_de_passe_fort>  # Utiliser : pwgen 32 1
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# ============================================
# MCP SERVER (Serveur principal)
# ============================================
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
LOG_LEVEL=INFO  # Options : DEBUG, INFO, WARNING, ERROR

# ============================================
# LLM APIs
# ============================================

# Anthropic (Claude) - Pour génération de cours de qualité
ANTHROPIC_API_KEY=sk-ant-<votre_clé_anthropic>
# Obtenir une clé : https://console.anthropic.com/

# OpenAI (ou compatible comme GlobalGPT) - Pour classification et RAG
OPENAI_API_KEY=sk-<votre_clé_openai_ou_globalgpt>
# OpenAI : https://platform.openai.com/api-keys
# GlobalGPT : https://globalgpt.io/

# Modèles par défaut (modifiable)
DEFAULT_CLASSIFICATION_MODEL=gpt-3.5-turbo  # Économique pour classification
DEFAULT_COURSE_MODEL=claude-sonnet-4        # Qualité pour génération de cours
DEFAULT_RAG_MODEL=gpt-3.5-turbo             # Économique pour RAG simple

# ============================================
# EMBEDDINGS
# ============================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2  # Léger et performant
EMBEDDING_DIMENSION=384

# ============================================
# TELEGRAM (Notifications)
# ============================================
# Optionnel : Pour recevoir des notifications sur Telegram
TELEGRAM_BOT_TOKEN=<votre_bot_token>
# Créer un bot : parler à @BotFather sur Telegram

TELEGRAM_CHAT_ID=<votre_chat_id>
# Obtenir votre chat_id : envoyer un message à votre bot, puis :
# curl https://api.telegram.org/bot<TOKEN>/getUpdates

# ============================================
# DASHBOARD (Frontend Next.js)
# ============================================
# Si hébergé localement (sinon, déployer sur Vercel)
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:8000
NEXTAUTH_SECRET=<générer_avec_openssl_rand_base64_32>
NEXTAUTH_URL=http://localhost:3000

# ============================================
# OPTIMISATIONS & LIMITES
# ============================================

# TTL (Time To Live) des données en jours
TTL_VEILLE_ITEMS_DAYS=90      # Items de veille archivés après 90 jours
TTL_LOGS_DAYS=30               # Logs purgés après 30 jours
TTL_VECTORS_DAYS=90            # Vecteurs LanceDB purgés après 90 jours

# Limites de ressources
MAX_ITEMS_PER_BATCH=20         # Nombre max d'items classifiés en un seul appel LLM
MAX_TOKENS_PER_REQUEST=4000    # Limite tokens par requête LLM
MAX_PARALLEL_AGENTS=3          # Nombre max d'agents Agno en parallèle

# Budget mensuel (alertes si dépassé)
MONTHLY_BUDGET_USD=20.0

# ============================================
# DÉVELOPPEMENT (optionnel, pour dev local)
# ============================================
ENV=production  # Options : development, production

# Si ENV=development, activer le debug et hot reload
DEBUG=false
HOT_RELOAD=false

# ============================================
# BACKUP (optionnel)
# ============================================
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30       # Conserver les backups 30 jours

# S3 compatible (optionnel, pour backup cloud)
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_BUCKET=academiaops-backups
# S3_ACCESS_KEY=<votre_access_key>
# S3_SECRET_KEY=<votre_secret_key>

# ============================================
# NOTES
# ============================================
# 
# Pour générer des mots de passe forts :
#   pwgen 32 1
#   ou
#   openssl rand -base64 32
#
# Pour tester la connexion PostgreSQL :
#   psql $POSTGRES_URL
#
# Pour vérifier les services Docker :
#   docker-compose ps
#   docker-compose logs -f <service>
#
