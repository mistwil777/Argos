# ========================================
# Argos - Environment Variables
# ========================================

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://argos:password@localhost:5432/argos

# ============================================
# Vector Database & Embeddings
# ============================================
LANCEDB_PATH=./data/lancedb

# Embedding Provider: "sentence-transformers" or "bedrock"
# Use "bedrock" to avoid HuggingFace CDN network issues
EMBEDDING_PROVIDER=bedrock

# SentenceTransformer model (only if EMBEDDING_PROVIDER=sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Bedrock Titan Embeddings dimensions (256, 512, or 1024)
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_EMBEDDING_NORMALIZE=true

# ============================================
# AWS Bedrock (Required for Bedrock embeddings & LLM)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-west-2
AWS_BEDROCK_MODEL=us.amazon.nova-pro-v1:0

# ============================================
# LLM Provider
# ============================================
LLM_PROVIDER=aws  # Options: aws, openai, anthropic

# OpenAI (optional)
OPENAI_API_KEY=sk-...

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# Telegram Bot (HITL)
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_chat_id
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook

# ============================================
# Application
# ============================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# Admin
ADMIN_TOKEN=<your-secret-admin-token>
